#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Base";
            bindings = <
                &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I     &kp O    &kp P    &kp BSPC
                &kp CAPS  &kp A    &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp K     &kp L    &kp SEMI &kp SQT
                &kp LSHFT &kp Z    &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH &kp ESC
                &kp LCTRL &none    &kp LALT &kp LGUI &mo 1    &kp SPACE    &kp RET  &none    &kp LALT  &kp RGUI &none    &kp DEL
            >;
        };

        lower_layer { // Layer 1
            display-name = "Lower";
            bindings = <
                &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4   &kp N5       &kp N6   &kp N7   &kp N8    &kp N9    &kp N0   &kp BSPC
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans   &trans       &trans   &kp LEFT &kp UP    &kp RIGHT &trans   &trans
                &kp LSHFT  &trans       &trans       &trans       &trans   &trans       &trans   &kp LEFT &kp DOWN  &kp RIGHT &trans   &kp ESC
                &kp LCTRL  &trans       &kp LALT     &kp LGUI     &trans   &kp SPACE    &kp RET  &trans   &kp LALT  &kp RGUI  &trans   &trans
            >;
        };
    };
};